# Copy to .env and fill in. Empty values are treated as unset; secrets are left blank on purpose.

# development | test | production (default: development)
NODE_ENV=development
# HTTP port the server listens on (default: 3000)
PORT=3000
# Public base URL of this service, no trailing slash; must be https in production (ElevenLabs calls our custom-LLM endpoint here)
PUBLIC_BASE_URL=http://localhost:3000
# Directory for the SQLite database (vashistha.db) and stored media
DATA_DIR=./data

# Anthropic API key (required in production)
ANTHROPIC_API_KEY=
# ElevenLabs API key (required in production)
ELEVENLABS_API_KEY=
# Interviewer agent id, written by the agent-sync script
ELEVENLABS_INTERVIEWER_AGENT_ID=
# Tutor agent id, written by the agent-sync script
ELEVENLABS_TUTOR_AGENT_ID=
# Bearer secret ElevenLabs sends to our custom-LLM endpoint, at least 32 chars (required in production); generate with `openssl rand -base64 48`
CUSTOM_LLM_SECRET=
# Bearer token MCP clients send to /mcp (check_action over the confirmed rulebook), at least 32 chars; unset = open in development, every request refused in production; generate with `openssl rand -base64 48`
MCP_BEARER_TOKEN=
# Model calls: on (default) | off (hermetic: no Anthropic client is created even with ANTHROPIC_API_KEY set; interview
# parsing/rephrasing, debrief prose and vision extraction all fall back or report unavailable; used by e2e).
# `pnpm preflight` fails if it is off here (env check) or on the deployed target (server-deep reads /api/health/deep).
LLM_CALLS=
# Vision extraction of uploaded screen frames: on (default; needs ANTHROPIC_API_KEY) | off (frames are still stored and ledgered, no model call).
# Vision-only kill switch; LLM_CALLS=off subsumes it for hermetic runs.
VISION_EXTRACTION=

# Accounts. Anyone may sign up, as a trainee; only an admin grants the expert role (an expert's confirmed words
# become rules). The first admin is created at boot from these two when no account has that username, and is never
# overwritten afterwards (an existing account under that name is never promoted). Set both or neither.
# ADMIN_USERNAME: lowercase letters, digits and hyphens. ADMIN_PASSWORD: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudflare R2 for redacted screen frames (they would otherwise fill the Railway volume). Set all four or none:
# none keeps frames on the volume under DATA_DIR/media. The bucket must be private; the API token needs Object
# Read & Write on that one bucket only. Frames older than the cap are deleted: see R2_MAX_BYTES.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Cap on stored frame bytes (default 2000000000 = 2 GB). When it is reached the oldest half of the bytes is deleted.
R2_MAX_BYTES=
# Tests only: an https URL replacing https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
