{
  "name": "vashistha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "pnpm --filter @vashistha/web build && vitest run --project web-bundle",
    "test:e2e": "pnpm --filter @vashistha/web vendor:tesseract && pnpm --filter @vashistha/web build && pnpm --filter @vashistha/web exec playwright test",
    "bench": "pnpm --filter @vashistha/bench bench",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:bundle",
    "db:generate": "pnpm --filter @vashistha/core db:generate",
    "agents:sync": "pnpm --filter @vashistha/web exec tsx ../../scripts/agents.ts",
    "preflight": "pnpm --filter @vashistha/web exec tsx ../../scripts/preflight.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "railway": "^3.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
